---
import Layout from './Layout.astro';
import { services } from '../data/services';
import { publishedPosts } from '../lib/posts';
import { absoluteUrl, faqSchema } from '../lib/site';
interface Props { slug: string; }
const service = services.find(s => s.slug === Astro.props.slug);
if (!service) throw new Error('Servicio desconocido');
const posts = (await publishedPosts()).filter(post => (service.posts as readonly string[]).includes(post.id));
const schema = { '@type': 'Service', '@id': absoluteUrl('/servicios/' + service.slug + '#service'), name: service.title, description: service.description, url: absoluteUrl('/servicios/' + service.slug), provider: { '@id': absoluteUrl('/#organization') }, areaServed: { '@type': 'Country', name: 'Perú' }, serviceType: service.label };
---
<Layout title={service.title} description={service.description} schema={[schema, faqSchema(service.faq, '/servicios/' + service.slug)]} breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Servicios', url: '/servicios' }, { name: service.label, url: '/servicios/' + service.slug }]}>
  <main id="main-content" class="page-main shell">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/servicios">Servicios</a><span>/</span><span aria-current="page">{service.label}</span></nav>
    <header class="page-heading"><span class="eyebrow">Soluciones para empresas de Perú · {service.number}</span><h1>{service.title}</h1><p>{service.intro}</p><a class="button" href="/contacto">{service.cta} ↗</a></header>
    <section class="split-section"><div class="prose"><h2>Cuándo encaja en tu operación</h2><p>{service.fit}</p></div><div class="info-card"><h2>Herramientas y responsabilidades</h2><p>{service.architecture}</p></div></section>
    <section class="prose narrow"><h2>Un recorrido para evaluar contigo</h2><p>{service.example}</p></section>
    <section class="section"><h2 class="section-title">{service.caseHeading}</h2><div class="cards-grid">{service.cases.map(([title, text]) => <article class="info-card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="split-section"><div><span class="eyebrow">Un alcance claro desde el inicio</span><h2>{service.deliveryHeading}</h2><ul class="check-list">{service.deliverables.map(item => <li>{item}</li>)}</ul></div><div class="info-card"><h2>Qué necesitamos para comenzar</h2><p>{service.requirements}</p><h3>Cómo se define el presupuesto</h3><p>{service.cost}</p><a class="text-link" href="/recursos/calculadora-ahorro-automatizacion">Estimar el valor del tiempo recuperado ↗</a></div></section>
    <section class="section narrow"><h2 class="section-title">Preguntas antes de empezar</h2>{service.faq.map(([q, a]) => <details class="faq-item"><summary>{q}</summary><p>{a}</p></details>)}</section>
    <section class="coverage-note"><h2>Aplicaciones para tu negocio y tu región</h2><p>Relaciona este alcance con los <a href="/sectores">procesos de tu sector</a> y utiliza el <a href="/peru">mapa de soluciones para empresas de Perú</a> para preparar sedes, responsables y coordinación remota.</p></section>
    <aside class="callout"><h2>{service.ctaTitle}</h2><p>{service.ctaText}</p><a href="/contacto" class="button">{service.cta} ↗</a></aside>
    <section class="split-section"><div><h2>Guías para decidir mejor</h2><ul class="resource-list">{posts.map(post => <li><a href={'/blog/' + post.id}>{post.data.title} ↗</a></li>)}</ul><a href={service.source} class="text-link">{service.sourceName} ↗</a></div><div><h2>Conecta esta solución con</h2><ul class="resource-list">{services.filter(s => s.slug !== service.slug).map(s => <li><a href={'/servicios/' + s.slug}>{s.label} ↗</a></li>)}</ul></div></section>
  </main>
</Layout>
