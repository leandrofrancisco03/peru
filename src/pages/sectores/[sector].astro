---
import Layout from '../../layouts/Layout.astro';
import { sectors } from '../../data/sectors';
import { regions } from '../../data/regions';
import { absoluteUrl, faqSchema } from '../../lib/site';
export function getStaticPaths() { return sectors.map(sector => ({ params: { sector: sector.slug }, props: { sector } })); }
interface Props { sector: typeof sectors[number]; }
const { sector } = Astro.props;
const schema = { '@type': 'Service', '@id': absoluteUrl('/sectores/' + sector.slug + '#service'), name: sector.title, description: sector.description, url: absoluteUrl('/sectores/' + sector.slug), provider: { '@id': absoluteUrl('/#organization') }, areaServed: { '@type': 'Country', name: 'Perú' } };
---
<Layout title={sector.title} description={sector.description} schema={[schema, faqSchema(sector.questions, '/sectores/' + sector.slug)]} breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Sectores', url: '/sectores' }, { name: sector.name, url: '/sectores/' + sector.slug }]}>
<main id="main-content" class="page-main shell"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/sectores">Sectores</a><span>/</span><span aria-current="page">{sector.name}</span></nav><header class="page-heading"><span class="eyebrow">{sector.name} · Perú</span><h1>{sector.title}</h1><p>{sector.intro}</p><a class="button" href="/contacto">Evaluar este flujo ↗</a></header><section class="prose narrow"><h2>El problema que conviene resolver primero</h2><p>{sector.problem}</p></section><section class="section"><h2 class="section-title">Un recorrido con controles en cada paso</h2><div class="cards-grid section-cards">{sector.workflow.map(([title,text],i) => <article class="info-card"><span class="eyebrow">Paso 0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section><section class="split-section"><div><h2>Información necesaria</h2><ul class="check-list">{sector.inputs.map(item => <li>{item}</li>)}</ul></div><div class="info-card"><h2>Qué debe pasar por revisión</h2><p>{sector.exceptions}</p><p>El sistema debe registrar errores y dejar una tarea recuperable cuando una API falle. La persona responsable necesita ver qué ocurrió y qué operación sigue pendiente.</p></div></section><section class="split-section"><div class="prose"><h2>Un piloto que puedas evaluar</h2><p>{sector.pilot}</p><p>Compara una muestra anterior y posterior con volumen similar. Incluye tiempo de supervisión y correcciones para que el ahorro estimado no oculte trabajo nuevo.</p></div><div><h2>Indicadores útiles</h2><ul class="check-list">{sector.metrics.map(metric => <li>{metric}</li>)}</ul><a class="text-link" href="/recursos/calculadora-ahorro-automatizacion">Estimar el ahorro con tus datos ↗</a></div></section><section class="section narrow"><h2 class="section-title">Antes de implementarlo</h2>{sector.questions.map(([q,a]) => <details class="faq-item"><summary>{q}</summary><p>{a}</p></details>)}</section><section class="split-section"><div><h2>De la guía a la implementación</h2><ul class="resource-list"><li><a href={'/servicios/' + sector.service}>Conocer el servicio relacionado ↗</a></li><li><a href={'/blog/' + sector.article}>Leer la guía detallada de este proceso ↗</a></li><li><a href="/blog/cuanto-cuesta-automatizar-procesos-peru">Cómo se calcula el presupuesto ↗</a></li></ul></div><div><h2>Contextos locales</h2><ul class="resource-list">{sector.regions.map(slug => <li><a href={'/peru/' + slug}>{regions.find(r => r.slug === slug)?.title} ↗</a></li>)}</ul><a class="text-link" href="/sectores">Ver otros tipos de negocio ↗</a></div></section><aside class="callout"><h2>Conecta este flujo con tu operación</h2><p>Revisamos las herramientas que ya usas y definimos un alcance que puedas comprobar.</p><a class="button" href="/contacto">Solicitar evaluación ↗</a></aside></main>
</Layout>
