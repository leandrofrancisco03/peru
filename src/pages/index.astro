---
import Layout from '../layouts/Layout.astro';
import SolutionImage from '../components/SolutionImage.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../lib/posts';
import { regions } from '../data/regions';
import { sectors } from '../data/sectors';
import { faqSchema, whatsappLink } from '../lib/site';
const posts = (await publishedPosts()).slice(0, 3);
const faqs = [
 ['¿Cuál sería un primer proyecto para una pyme?', 'Una tarea con entrada y salida reconocibles: registrar solicitudes, preparar cotizaciones o consolidar un reporte. Revisamos frecuencia, datos y quién puede validar el resultado antes de elegir el alcance.'],
 ['¿Cómo coordinan un proyecto desde otra región?', 'La atención es remota. Definimos una persona de referencia, revisamos muestras anonimizadas y probamos el recorrido con el equipo que lo utilizará. Las sedes y horarios se incorporan como reglas de la operación.'],
 ['¿Es necesario reemplazar mi CRM?', 'Primero comprobamos sus accesos y operaciones disponibles. Si permite las conexiones necesarias, puede seguir siendo la fuente comercial; si no, explicamos la limitación y las alternativas.'],
 ['¿Qué recibe mi equipo al implementar un flujo?', 'El alcance acordado debe identificar las conexiones, pruebas, documentación y procedimiento para atender errores. La operación posterior y el soporte se definen en la propuesta.'],
 ['¿Cómo se decide si hace falta IA?', 'Se usa cuando interpretar lenguaje o documentos aporta utilidad. Los cálculos, permisos y estados verificables se resuelven con reglas y fuentes autorizadas.'],
] as const;
---
<Layout title="Automatización e IA para empresas en Perú | Mavetio" description="Automatización con n8n, chatbots para WhatsApp, agentes IA y software para empresas de Perú. Conecta tus herramientas y solicita una propuesta con atención remota." schema={faqSchema(faqs, '/')}>
<main id="main-content">
<section class="hero-section"><div class="shell hero-grid"><div class="hero-copy"><span class="eyebrow"><span class="status-dot"></span> Systems · Automation · Intelligence</span><h1>Automatización de procesos<br /><span class="gradient-text">e IA para empresas.</span></h1><p>Ayudamos a empresas de Perú a reducir tareas repetitivas, atender consultas y organizar sus operaciones con automatizaciones n8n, chatbots, agentes de IA y software conectado a sus herramientas.</p><div class="hero-actions"><a class="button" href="/contacto">Solicitar una cotización ↗</a><a class="button button-secondary" href={whatsappLink("Hola, quisiera consultar sobre una automatización para mi negocio con Mavetio.")} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp ↗</a></div><a class="text-link" href="#ejemplos">Ver ejemplos de automatización ↓</a><p class="hero-note">Implementación remota · CRM y APIs · Web, WhatsApp y Telegram</p></div>
<SolutionImage kind="hero" priority /></div></section>
<section class="shell section" aria-labelledby="soluciones-principales"><h2 id="soluciones-principales" class="section-title">Tres formas de simplificar tu operación</h2><div class="cards-grid section-cards solution-cards">{[
['automatizacion-con-n8n','Automatizaciones con n8n','Evita volver a copiar solicitudes y preparar el mismo reporte. Conectamos los pasos repetitivos y avisamos cuando se necesita revisión.'],
['agentes-de-inteligencia-artificial','Chatbots y agentes de IA','Orienta a tus clientes con información aprobada y entrega las consultas complejas a una persona con el contexto necesario.'],
['integraciones-y-apis','Integraciones y software a medida','Conecta ventas, administración y operaciones. Desarrollamos una interfaz propia cuando tus herramientas no cubren el proceso.']
].map(([slug,title,text])=><article class="info-card" data-image-slot={slug}><h3>{title}</h3><p>{text}</p><a class="text-link" href={'/servicios/'+slug}>Ver {title} <span aria-hidden="true">↗</span></a></article>)}</div><p class="section-intro">¿Necesitas una aplicación propia? Consulta nuestro <a href="/servicios/desarrollo-de-software">servicio de desarrollo de software</a>.</p></section>
<section class="shell section" id="ejemplos"><h2 class="section-title">Ejemplos de lo que podemos automatizar</h2><p class="section-intro">Escenarios demostrativos para evaluar contigo; no son casos ni resultados de clientes.</p><div class="example-flow"><div><span class="eyebrow">Del mensaje a la próxima acción</span><h3>Así se prepara una cotización</h3><p>La automatización reúne los datos y prepara el trabajo. Tu equipo conserva la aprobación antes de enviar una propuesta.</p></div><div class="workflow-card" aria-label="Ejemplo propuesto: solicitud comercial hasta revisión del asesor"><div class="workflow-top"><span class="status-dot"></span> Una cotización, de principio a fin</div><div class="workflow-node"><span class="node-icon">01</span><div><strong>El cliente consulta</strong><small>Producto, cantidad y necesidad</small></div></div><div class="flow-line"></div><div class="workflow-node highlighted"><span class="node-icon">02</span><div><strong>n8n prepara el trabajo</strong><small>Valida datos · Consulta catálogo · Registra</small></div></div><div class="flow-line"></div><div class="workflow-branches"><div><span>↳</span><strong>Asesor</strong><small>Aprueba la propuesta</small></div><div><span>↳</span><strong>CRM</strong><small>Conserva versión y próxima acción</small></div></div><div class="workflow-bottom"><span>Ejemplo de diseño</span><a class="text-link" href="/blog/automatizar-cotizaciones-seguimiento-peru">Ver el recorrido ↗</a></div></div></div><div class="cards-grid">{[
['Seguimiento de prospectos','Formulario o consulta por WhatsApp.','Validar datos, registrar la oportunidad y asignar un responsable.','Una solicitud con próxima acción visible en el CRM.','automatizar-leads-n8n-crm'],
['Atención de preguntas frecuentes','Consulta de un cliente sobre un servicio.','Buscar información aprobada y derivar cuando falta evidencia o se necesita una excepción.','Respuesta orientativa o tarea para un asesor con contexto.','agentes-ia-atencion-cliente'],
['Reportes conectados','Datos de APIs, hojas de cálculo y bases de datos.','Consolidar, comprobar duplicados y señalar fuentes pendientes.','Un reporte con corte y cobertura identificados para revisión.','automatizar-reportes-ventas-peru']
].map(([title,input,process,result,slug])=><article class="info-card"><h3>{title}</h3><p><strong>Entrada:</strong> {input}</p><p><strong>Proceso:</strong> {process}</p><p><strong>Resultado esperado:</strong> {result}</p><a class="text-link" href={'/blog/'+slug}>Ver el diseño del ejemplo ↗</a></article>)}</div></section>
<section class="shell section"><div class="section-heading"><div><span class="eyebrow">Dónde se pierde trabajo</span><h2>Parte del pendiente,<br />elige la conexión.</h2></div><p>Una conversación sin seguimiento, una propuesta desactualizada y un reporte incompleto requieren soluciones diferentes.</p></div><div class="cards-grid">{[['/blog/automatizar-leads-n8n-crm','Solicitudes que no llegan a ventas','Recibe, registra y asigna. Detecta lo pendiente aunque el CRM no responda al primer intento.'],['/blog/agentes-ia-atencion-cliente','Consultas que vuelven a empezar','Clasifica el motivo y transfiere al asesor con contexto, sin repetir todo el interrogatorio.'],['/blog/automatizar-reportes-ventas-peru','Totales que cambian entre archivos','Define cortes, monedas y correcciones para publicar un reporte que puedas rastrear.']].map(([url,title,text])=><article class="info-card"><h3><a href={url}>{title}</a></h3><p>{text}</p><a class="text-link" href={url}>Revisar cómo resolverlo ↗</a></article>)}</div></section>
<section class="process-section"><div class="shell section"><div class="section-heading"><div><span class="eyebrow">Capacidades de implementación</span><h2>Flujos, agentes y sistemas<br />con responsabilidades claras.</h2></div><a class="text-link" href="/servicios">Comparar alcances ↗</a></div><ServiceCards /></div></section>
<section class="shell section"><div class="section-heading"><div><span class="eyebrow">Una operación distinta en cada negocio</span><h2>Qué debe confirmarse antes de avanzar</h2></div><a class="text-link" href="/sectores">Explorar los cuatro sectores ↗</a></div><div class="sector-grid">{sectors.map(s=><article class="info-card"><h3><a href={'/sectores/'+s.slug}>{s.name}</a></h3><p>{s.intro}</p></article>)}</div></section>
<section class="process-section"><div class="shell section"><div class="section-heading"><div><span class="eyebrow">Perú · Coordinación remota</span><h2>Sedes y zonas son reglas<br />de tu proceso.</h2></div><p>La ubicación puede cambiar una asignación, una entrega o una agenda. Estas guías desarrollan escenarios operativos para revisar contigo.</p></div><div class="region-links">{regions.map(r=><a href={'/peru/'+r.slug}><strong>{r.name}</strong><span>{r.focus}</span><span aria-hidden="true">↗</span></a>)}</div><a class="text-link" href="/peru">Ver el mapa de soluciones para Perú ↗</a></div></section>
<section class="shell section"><div class="section-heading"><div><span class="eyebrow">Cómo delimitamos el proyecto</span><h2>Un piloto que puedas aceptar<br />por su resultado.</h2></div><a class="text-link" href="/sobre-nosotros">Método y criterios editoriales ↗</a></div><div class="process-grid">{[['01','Observamos una muestra','Revisamos entrada, resultado, tiempo y excepciones con quien realiza la tarea.'],['02','Acordamos la prueba','Definimos qué debe ocurrir, qué decide una persona y cómo recuperar un fallo.'],['03','Entregamos para operar','Comprobamos el recorrido con el equipo y dejamos instrucciones para atender pendientes.']].map(([n,t,d])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></section>
<section class="shell section"><div class="resource-banner"><div><span class="eyebrow">Antes de invertir</span><h2>Estima capacidad recuperable en soles</h2><p>Incluye supervisión y operación para comparar un escenario conservador con el esperado.</p></div><a class="button button-secondary" href="/recursos/calculadora-ahorro-automatizacion">Probar mis supuestos ↗</a></div></section>
<section class="shell section"><div class="section-heading"><div><span class="eyebrow">Guías de implementación</span><h2>Decisiones que conviene resolver primero</h2></div><a class="text-link" href="/blog">Elegir un recorrido de lectura ↗</a></div><div class="cards-grid">{posts.map(post=><PostCard post={post}/>)}</div></section>
<section class="shell section narrow"><h2 class="section-title">Para preparar el primer alcance</h2>{faqs.map(([q,a])=><details class="faq-item"><summary>{q}</summary><p>{a}</p></details>)}</section>
<aside class="shell callout"><h2>Muéstranos dónde se detiene una solicitud</h2><p>Con una tarea concreta y un ejemplo anonimizado podemos revisar qué conectar y qué necesita seguir bajo aprobación.</p><a class="button" href="/contacto">Solicitar una cotización ↗</a></aside>
</main></Layout>
